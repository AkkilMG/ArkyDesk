# Environment Variables Configuration
# Copy this file to .env.local for local development
# For Cloudflare deployment, use wrangler secrets (see setup-secrets.ps1)

# Encryption and Security
SECRET_KEY=your-32-character-secret-key-for-encryption
SESSION_SECRET=your-32-character-secret-key-for-sessions

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=your-database-name

# Application Configuration
BASE_URL=http://localhost:3000
# For production: https://your-domain.com

# Central Auth Server (auth.arkynox.com)
AUTH_SERVER_URL=https://auth.arkynox.com
AUTH_CLIENT_ID=arkdesk
# Must match ARKDESK_CLIENT_SECRET on the auth server (token-endpoint client auth)
AUTH_CLIENT_SECRET=

# Email Configuration (Optional - currently commented out in code)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Development/Build Environment
NODE_ENV=development
